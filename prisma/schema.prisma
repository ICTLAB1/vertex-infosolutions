// Vertex Infosolutions — storefront schema.
//
// Two things drive the shape of this file.
//
// A basket can hold a monitor and a licence key at once. Those are one payment
// with two different afterlives: the monitor is reserved, packed, couriered and
// returnable; the licence is issued, emailed and generally not. So `Order` is
// the money object — one total, one GST computation, one payment — and
// `Fulfilment` sits beneath it carrying status. An order can be delivered
// digitally and in transit physically at the same time, and nothing about that
// is a special case.
//
// SQLite has no enums and no scalar lists. Union-typed strings stand in for
// enums (the allowed values are in `src/lib/types.ts`, which is the one place
// they are written down), and lists are JSON text.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Category {
  id       String    @id @default(cuid())
  slug     String    @unique
  name     String
  /// Shown in the nav strip in this order, low to high.
  position Int       @default(0)
  products Product[]
}

model Brand {
  id       String    @id @default(cuid())
  slug     String    @unique
  name     String
  products Product[]
}

model Product {
  id         String  @id @default(cuid())
  slug       String  @unique
  name       String
  /// "PHYSICAL" | "LICENCE" — decides whether this needs an address, stock and
  /// a courier, or an inbox. See `ProductKind`.
  kind       String
  brandId    String
  categoryId String
  summary    String
  /// JSON array of strings — the "About this item" bullets.
  bullets    String  @default("[]")
  /// JSON object of spec name to value, rendered as the spec table.
  specs      String  @default("{}")
  /// Goods are taxed under an HSN code, licences under a SAC code. Printed on
  /// the invoice, so it is stored rather than guessed at print time.
  hsnSac     String?
  /// Required on every listing sold in India by the Legal Metrology rules.
  /// Licences carry the publisher's country.
  origin     String
  /// Which glyph to draw in place of a photograph. See `src/components/glyph`.
  glyph      String  @default("box")
  featured   Boolean @default(false)
  createdAt  DateTime @default(now())

  brand    Brand     @relation(fields: [brandId], references: [id])
  category Category  @relation(fields: [categoryId], references: [id])
  variants Variant[]
  reviews  Review[]

  @@index([categoryId])
  @@index([brandId])
}

model Variant {
  id        String @id @default(cuid())
  productId String
  sku       String @unique
  /// "8 GB / 512 GB", "5 seats, 1 year" — what distinguishes this from its
  /// siblings. A product with one variant repeats the product name.
  name      String

  /// Money is always minor units (paise). No floats anywhere near a price.
  /// `mrpMinor` is the printed maximum retail price and only exists to be
  /// struck through; `priceMinor` is what is actually charged.
  mrpMinor       Int
  priceMinor     Int
  gstRatePercent Int @default(18)

  /// Null for a licence, which cannot run out. A number for anything shipped,
  /// and it is the only thing standing between the catalogue and overselling.
  stockOnHand Int?
  /// Working days from dispatch, used for the delivery estimate. Null for a
  /// licence, which arrives on payment.
  leadDays    Int?

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId])
}

model Review {
  id        String   @id @default(cuid())
  productId String
  author    String
  rating    Int
  title     String
  body      String
  /// Set when the reviewer's email matches a delivered order for this product.
  /// A badge that is awarded rather than typed in is worth something.
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

/// A basket belonging to a browser, not to a person. The cookie holds `token`
/// and nothing else, so a signed-in account is not required to shop and a cart
/// survives a closed tab.
model Cart {
  id        String     @id @default(cuid())
  token     String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     CartItem[]
}

model CartItem {
  id        String @id @default(cuid())
  cartId    String
  variantId String
  qty       Int    @default(1)

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  /// One line per variant. Adding the same SKU twice raises the quantity.
  @@unique([cartId, variantId])
  @@index([cartId])
}

model Order {
  id     String @id @default(cuid())
  /// Human-facing and quoted down the phone, so it is generated rather than
  /// being the primary key.
  number String @unique

  email String
  phone String

  /// Null when every line is a licence — there is nothing to deliver, so
  /// demanding an address would be theatre.
  shipName    String?
  shipLine1   String?
  shipLine2   String?
  shipCity    String?
  shipState   String?
  shipPincode String?

  /// The order total, decomposed so the invoice can show its working and the
  /// customer is never surprised at the payment step.
  itemsMinor    Int
  shippingMinor Int
  taxMinor      Int
  totalMinor    Int

  /// "PENDING" | "PAID" | "FAILED" | "REFUNDED"
  paymentStatus String @default("PENDING")
  /// "UPI" | "CARD" | "NETBANKING" | "COD"
  paymentMethod String
  paidAt        DateTime?

  createdAt DateTime @default(now())

  items       OrderItem[]
  fulfilments Fulfilment[]
}

/// One per order per fulfilment kind: at most a shipment and a digital
/// delivery. Status lives here rather than on the order, because a mixed
/// basket has no single true status.
model Fulfilment {
  id      String @id @default(cuid())
  orderId String
  /// "SHIPMENT" | "DIGITAL"
  kind    String

  /// Shipment: "PENDING" -> "PACKED" -> "SHIPPED" -> "DELIVERED".
  /// Digital:  "PENDING" -> "ISSUED".
  status String @default("PENDING")

  courier     String?
  awb         String?
  trackingUrl String?

  /// What the customer was promised when they paid, so a slipped delivery is
  /// visible rather than quietly rewritten.
  promisedBy  DateTime?
  completedAt DateTime?

  order Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items OrderItem[]

  @@unique([orderId, kind])
  @@index([orderId])
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  fulfilmentId String
  variantId    String?

  /// The catalogue can be edited or a SKU withdrawn; an order is a record of
  /// what was sold on the day, so the line copies what it needs and keeps the
  /// variant link only for convenience.
  sku            String
  name           String
  variantName    String
  kind           String
  qty            Int
  unitPriceMinor Int
  gstRatePercent Int
  hsnSac         String?

  /// A shipped item can come back within the return window. A licence key
  /// cannot once it has been revealed, and the order page says so rather than
  /// offering a button that would fail.
  returnable Boolean @default(false)
  /// Set once the key is generated. Never shown in a list view.
  licenceKey String?

  order      Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fulfilment Fulfilment @relation(fields: [fulfilmentId], references: [id], onDelete: Cascade)
  variant    Variant?   @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([fulfilmentId])
}
