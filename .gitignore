# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# prisma
/src/generated
*.db
*.db-journal

# the template is meant to be committed; the real .env is not
!.env.example

# The deployment parameters hold live secrets. The example beside it does not.
/infra/main.parameters.json

# Distributor price lists carry our buy price beside the public one. Only the
# extracted public columns belong in the repository — see
# scripts/import-price-list.py.
*.xlsx
*.xls
