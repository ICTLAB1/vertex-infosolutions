# Copy to `.env` and fill in. Nothing here has a default that would be safe to
# ship — the store shows a "not ready to launch" notice in development until the
# company fields below are set.

# --- Database -------------------------------------------------------------
# Local development, via docker compose:
DATABASE_URL="postgresql://vertex:vertex@localhost:5432/vertex?schema=public"
#
# Azure Database for PostgreSQL Flexible Server requires TLS, so keep
# sslmode=require on the deployed value:
# DATABASE_URL="postgresql://USER:PASSWORD@SERVER.postgres.database.azure.com:5432/vertex?sslmode=require"
#
# Per-instance connection pool. App Service scales by adding instances and
# Flexible Server caps connections by tier, so keep this small enough that
# max_instances * DATABASE_POOL_MAX stays under the server's limit.
DATABASE_POOL_MAX="10"

# --- Market detection -----------------------------------------------------
# The store prices in INR for visitors in India and USD for everyone else.
# There is no STORE_CURRENCY: both prices live in the `Price` table, entered
# per currency rather than converted.
#
# Nothing on Azure App Service tells the app where a caller is. Put a geo-IP
# lookup at the edge (Front Door rule, Cloudflare, or a reverse proxy) that
# sets a two-letter country header, and name that header here. Without it the
# app falls back to Accept-Language, which is weaker but not useless.
#
# Recognised without configuration: cf-ipcountry, x-country-code,
# x-appengine-country, x-vercel-ip-country.
GEO_COUNTRY_HEADER=""

# --- Application ----------------------------------------------------------
# Absolute, and matching the deployed host. Stripe returns customers here and
# notification emails link here, so it is configuration rather than something
# derived from a request Host header — which is attacker-controlled, and using
# it would let somebody redirect a successful payment to their own site.
APP_URL="http://localhost:3000"

# --- Stripe ---------------------------------------------------------------
# With no secret key, checkout falls back to a simulated payment so the whole
# flow is testable in development. That fallback refuses to run when NODE_ENV
# is production: a live store that marks orders paid without taking money is
# worse than one that cannot check out.
#
# Which methods appear — card, UPI, net banking, wallets — is decided by your
# Stripe dashboard and the buyer's country, not by this app.
STRIPE_SECRET_KEY=""
# From `stripe listen` locally, or the endpoint's signing secret in the
# dashboard. Without it the webhook returns 503 and orders never complete.
STRIPE_WEBHOOK_SECRET=""

# --- Email ----------------------------------------------------------------
# Resend's HTTP API. Without both of these, messages are still written to the
# Notification table but never sent — which is fine in development and fatal in
# production, because the OTP is how an account gets verified.
RESEND_API_KEY=""
EMAIL_FROM="Vertex Infosolutions <orders@example.com>"

# --- WhatsApp (Meta Cloud API) --------------------------------------------
# Optional. Order confirmations only — never licence keys, never a one-time
# code, because a message in a chat thread is one forward away from somebody
# else's licence.
#
# Business-initiated WhatsApp requires a template Meta approved in advance;
# free-form text is only allowed inside a 24-hour reply window. Create and get
# approval for the three templates below before enabling this, or every send
# fails.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_API_VERSION="v21.0"
WHATSAPP_TEMPLATE_LOCALE="en"
# Approved template names. Body variables are positional.
#   vertex_order_paid    {{1}} name {{2}} order number {{3}} total {{4}} link
#   vertex_order_pending {{1}} name {{2}} order number {{3}} total
#   vertex_licence_expiring {{1}} name {{2}} what expires {{3}} date {{4}} days
WHATSAPP_TEMPLATE_ORDER_PAID="vertex_order_paid"
WHATSAPP_TEMPLATE_ORDER_PENDING="vertex_order_pending"
WHATSAPP_TEMPLATE_LICENCE_EXPIRING="vertex_licence_expiring"

# --- Renewal reminders ----------------------------------------------------
# The store promises a reminder a month before a subscription expires, and
# `POST /api/cron/renewals` is what sends it. Point a scheduler at it once a
# day with this secret in the `x-vertex-cron-key` header:
#
#   curl -fsS -X POST "$APP_URL/api/cron/renewals" -H "x-vertex-cron-key: $CRON_SECRET"
#
# Running it more often is harmless — each reminder is claimed before it is
# sent, so a second run the same day sends nothing. Leaving it unset makes the
# endpoint return 503 rather than run unauthenticated: an open endpoint here
# would let anyone burn the whole reminder window early, and every send costs
# money at the mail provider. Use a long random value:
#   openssl rand -hex 32
CRON_SECRET=""

# --- Who the seller legally is --------------------------------------------
# Rendered in the footer and on /contact. A field left blank is not rendered.
# Distance selling into the EEA and the UK requires the trader's identity and
# address to be given before the customer is bound by the contract.

COMPANY_TRADING_NAME="Vertex Infosolutions"
COMPANY_LEGAL_NAME=""
COMPANY_ADDRESS=""

# Where licences are supplied from. Decides which export regime applies, and
# whether a sale is a domestic supply or an export.
COMPANY_SHIPS_FROM="India"

# Company registration. Relabel for a non-Indian entity, e.g.
# COMPANY_REGISTRATION_LABEL="Company No."
COMPANY_REGISTRATION_LABEL="CIN"
COMPANY_REGISTRATION_NUMBER=""

# Tax identity. GSTIN for an Indian entity; VAT number, EIN etc. elsewhere.
COMPANY_TAX_ID_LABEL="GSTIN"
COMPANY_TAX_ID=""

COMPANY_SUPPORT_EMAIL=""
COMPANY_SUPPORT_PHONE=""
# Give UTC as well as local time — most customers are in another timezone.
COMPANY_SUPPORT_HOURS="Monday to Friday, 04:00–13:00 UTC (09:30–18:30 IST)"

# A named person who answers escalated complaints.
COMPANY_COMPLAINTS_OFFICER_NAME=""
COMPANY_COMPLAINTS_OFFICER_EMAIL=""
