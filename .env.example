# Copy to `.env` and fill in. Nothing here has a default that would be safe to
# ship — the store shows a "not ready to launch" notice in development until the
# company fields below are set.

# SQLite for local development. Point this at Postgres before deploying, and
# swap the adapter in src/lib/db.ts to match (see prisma-database-setup).
DATABASE_URL="file:./dev.db"

# --- Who the seller legally is -------------------------------------------
# An online marketplace in India has to publish its legal name and address,
# a customer-care contact, and a named grievance officer. These are rendered in
# the footer and on /grievance; a field left blank is not rendered at all.

COMPANY_TRADING_NAME="Vertex Infosolutions"
COMPANY_LEGAL_NAME=""
COMPANY_ADDRESS=""
COMPANY_GSTIN=""
COMPANY_CIN=""

COMPANY_SUPPORT_EMAIL=""
COMPANY_SUPPORT_PHONE=""

# Consumer Protection (E-Commerce) Rules, 2020 — a named person, contactable,
# who acknowledges a complaint within 48 hours.
COMPANY_GRIEVANCE_OFFICER_NAME=""
COMPANY_GRIEVANCE_OFFICER_EMAIL=""
COMPANY_GRIEVANCE_OFFICER_PHONE=""
